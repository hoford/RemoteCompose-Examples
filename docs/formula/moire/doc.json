         "value": "62.000 + 48.000 * sin(t * 0.2100)",
         "commit": true
        }
       },
       {
        "variable": {
         "name": "offX",
         "value": "dist * cos(ang) + dragX * 0.350",
         "commit": true
        }
       },
       {
        "variable": {
