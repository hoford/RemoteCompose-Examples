        "touchExpression": {
         "name": "dragX",
         "defaultValue": 0.0,
         "min": -90.0,
         "max": 90.0,
         "stopMode": "gently",
         "expression": "touchX()"
        }
       },
       {
        "touchExpression": {
         "name": "dragY",
         "defaultValue": 0.0,
         "min": -90.0,
         "max": 90.0,
         "stopMode": "gently",
         "expression": "touchY()"
        }
