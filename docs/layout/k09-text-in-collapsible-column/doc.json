            "modifiers": [{"background": "#FF4DA3FF"}] },
          { "type": "text", "text": "Sat, 1 Aug", "color": "#FF0B1020", "fontSize": 18,
            "modifiers": ["fillMaxWidth", {"background": "#FFFFB020"}] }
        ] }
    ]
  }
}
