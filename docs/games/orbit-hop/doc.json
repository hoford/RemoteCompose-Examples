                    "215",
                    "140",
                    "325",
                    "265"
                  ],
                  "count": 1
                }
              },
              {
                "createParticles": {
                  "id": "sh",
                  "variables": [
                    "px",
                    "py",
                    "pvx",
                    "pvy",
                    "ang",
                    "host",
                    "hx",
                    "hy",
                    "d1",
                    "d2",
                    "d3",
                    "cap",
                    "nhx",
                    "nhy",
                    "polx",
                    "poly"
                  ],
                  "initialValues": [
                    "200",
                    "200",
                    "0",
                    "0",
                    "0",
                    "0",
                    "200",
                    "200",
                    "999",
                    "999",
                    "999",
                    "0",
                    "200",
                    "200",
                    "0",
                    "0"
                  ],
                  "count": 1
                }
              },
              {
                "impulseProcess": {
                  "commands": [
                    {
                      "particlesLoop": {
                        "system": "@st",
                        "equations": [
                          "sign(max(0, touchTime - animationTime + 0.15)) * ifElse(0, 1, touchTime)",
                          "touch",
                          "touch * (1 - prevT)",
                          "ifElse(tapX, touchX, edge)",
                          "ifElse(tapY, touchY, edge)",
                          "level + adv",
                          "ifElse(level, -1, die)",
                          "ifElse(0, 1, abs(level - curLvl) - 0.5)",
                          "1",
                          "die + (1 - started)",
                          "ifElse(grace + 1, 0, rebuild)",
                          "ifElse(0, 1, driftT - 220) * ifElse(0, 1, grace - 30)",
                          "ifElse(0, 1, host - 1.5) * (1 - inGoal)",
                          "hitG * (1 - wasHit)",
                          "ifElse(0, 1, host - 1.5)",
                          "hitG",
                          "score + adv",
                          "max(0, lives - die)",
                          "1 + level * 0.1",
                          "ifElse(gx, 200 + 132 * cos(level * 2.4), rebuild)",
                          "ifElse(gy, 200 + 105 * sin(level * 2.4), rebuild)",
                          "26",
                          "ifElse(0, 1, lives - 0.5)",
                          "ifElse(ifElse(mode, 1, edge * (1 - mode)), 0, cap)",
                          "ifElse(relT + 1, 0, edge * (1 - mode))",
                          "ifElse(driftT * mode + mode, 0, rebuild)",
                          "max(34, 48 - level * 1.4)",
                          "ifElse(p1x, 200 + 116 * cos(level * 0.7 + 0.0), rebuild)",
                          "ifElse(p1y, 200 + 92 * sin(level * 0.7 + 0.0), rebuild)",
                          "ifElse(p2x, 200 + 116 * cos(level * 0.7 + 2.0944), rebuild)",
                          "ifElse(p2y, 200 + 92 * sin(level * 0.7 + 2.0944), rebuild)",
                          "ifElse(p3x, 200 + 116 * cos(level * 0.7 + 4.1888), rebuild)",
                          "ifElse(p3y, 200 + 92 * sin(level * 0.7 + 4.1888), rebuild)"
                        ],
                        "commands": [
                          {
                            "paint": {
                              "color": "#FF1D2740",
                              "style": "stroke",
                              "strokeWidth": 1
                            }
                          },
                          {
                            "drawCircle": {
                              "cx": "@p1x",
                              "cy": "@p1y",
                              "radius": 46
                            }
                          },
                          {
                            "drawCircle": {
                              "cx": "@p2x",
                              "cy": "@p2y",
                              "radius": 46
                            }
                          },
