                              "cy": "@p1y",
                              "radius": 26
                            }
                          },
                          {
                            "drawCircle": {
                              "cx": "@p2x",
                              "cy": "@p2y",
                              "radius": 22
                            }
                          },
                          {
                            "paint": {
                              "color": "#FF8B95A5",
                              "style": "fill"
                            }
                          },
                          {
                            "drawCircle": {
                              "cx": "@p1x",
                              "cy": "@p1y",
                              "radius": 20
                            }
                          },
                          {
                            "drawCircle": {
                              "cx": "@p2x",
                              "cy": "@p2y",
                              "radius": 16
                            }
                          },
                          {
                            "paint": {
                              "color": "#FF16412A",
                              "style": "fill"
                            }
                          },
                          {
                            "drawCircle": {
                              "cx": "@p3x",
                              "cy": "@p3y",
                              "radius": 26
                            }
                          },
                          {
                            "paint": {
                              "color": "#FF3DDC84",
                              "style": "fill"
                            }
                          },
                          {
                            "drawCircle": {
                              "cx": "@p3x",
                              "cy": "@p3y",
                              "radius": 20
                            }
                          }
                        ]
                      }
                    },
                    {
                      "particlesLoop": {
                        "system": "@sh",
                        "equations": [
                          "ifElse(ifElse(hx + cos(ang) * 46, min(max(px + pvx * alive, 22), 378), mode - 0.5), hx + 46, respawn)",
                          "ifElse(ifElse(hy + sin(ang) * 46, min(max(py + pvy * alive, 66), 334), mode - 0.5), hy, respawn)",
                          "ifElse(ifElse(abs(pvx) * polx + pvx * (1 - abs(polx)), -sin(ang) * 4.2, edge * (1 - mode)), 0, respawn)",
                          "ifElse(ifElse(abs(pvy) * poly + pvy * (1 - abs(poly)), cos(ang) * 4.2, edge * (1 - mode)), 0, respawn)",
                          "ifElse(ifElse(ang + 0.045 * spd * (1 - mode) * alive, atan2(py - nhy, px - nhx), cap), 0, respawn)",
                          "ifElse(ifElse(host, ifElse(ifElse(0, 1, ifElse(0, 1, capR - d2)), 2, ifElse(0, 1, capR - d3)), cap), 0, respawn)",
                          "ifElse(ifElse(p1x, p2x, host - 0.5), p3x, host - 1.5)",
                          "ifElse(ifElse(p1y, p2y, host - 0.5), p3y, host - 1.5)",
                          "hypot(px - p1x, py - p1y)",
                          "hypot(px - p2x, py - p2y)",
                          "hypot(px - p3x, py - p3y)",
                          "ifElse(0, 1, relT - 22) * mode * max(ifElse(0, 1, capR - d1), max(ifElse(0, 1, capR - d2), ifElse(0, 1, capR - d3)))",
                          "ifElse(ifElse(p1x, p2x, ifElse(0, 1, capR - d2)), p3x, ifElse(0, 1, capR - d3))",
                          "ifElse(ifElse(p1y, p2y, ifElse(0, 1, capR - d2)), p3y, ifElse(0, 1, capR - d3))",
                          "ifElse(0, 1, 22.5 - px) - ifElse(0, 1, px - 377.5)",
                          "ifElse(0, 1, 66.5 - py) - ifElse(0, 1, py - 333.5)"
                        ],
                        "commands": [
