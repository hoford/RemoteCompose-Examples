                      "particlesLoop": {
                        "system": "@ball",
                        "equations": [
                          "ifElse(min(max(bx + bvx * alive, 22), 378), 200 - 128 * cos(level * 0.9 + 1.5708), respawn)",
                          "ifElse(min(max(by + bvy * alive, 66), 334), 200 - 102 * sin(level * 0.9 + 1.5708), respawn)",
                          "ifElse((abs(bvx * 0.99 + ax) * bolx + (bvx * 0.99 + ax) * (1 - abs(bolx))) * bsc, 0, respawn)",
                          "ifElse((abs(bvy * 0.99 + ay) * boly + (bvy * 0.99 + ay) * (1 - abs(boly))) * bsc, 0, respawn)",
                          "ifElse(0, 1, 22.5 - bx) - ifElse(0, 1, bx - 377.5)",
                          "ifElse(0, 1, 66.5 - by) - ifElse(0, 1, by - 333.5)",
                          "max(hypot(bx - m1x, by - m1y), 1)",
                          "max(hypot(bx - m2x, by - m2y), 1)",
                          "pol * 30 * ((m1x - bx) / (max(d1, 40) * d1) + (m2x - bx) / (max(d2, 40) * d2))",
                          "pol * 30 * ((m1y - by) / (max(d1, 40) * d1) + (m2y - by) / (max(d2, 40) * d2))",
                          "hypot(bvx, bvy)",
                          "min(1, 5 / max(bsp, 0.01))",
                          "ifElse(0, 1, gr - 2 - hypot(bx - gx, by - gy))",
                          "h1t"
