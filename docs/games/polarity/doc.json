              },
              {
                "impulseProcess": {
                  "commands": [
                    {
                      "particlesLoop": {
                        "system": "@st",
                        "equations": [
                          "sign(max(0, touchTime - animationTime + 0.15)) * ifElse(0, 1, touchTime)",
                          "touch",
                          "touch * (1 - prevT)",
                          "ifElse(tapX, touchX, edge)",
                          "ifElse(tapY, touchY, edge)",
                          "level + adv",
                          "ifElse(level, -1, die)",
                          "ifElse(0, 1, abs(level - curLvl) - 0.5)",
                          "1",
                          "die + (1 - started)",
                          "ifElse(grace + 1, 0, rebuild)",
                          "hit * ifElse(0, 1, grace - 30)",
                          "goalHit * (1 - inGoal)",
                          "hitG * (1 - wasHit)",
                          "goalHit",
                          "hitG",
                          "score + adv",
                          "max(0, lives - die)",
                          "1 + level * 0.1",
                          "ifElse(gx, 200 + 128 * cos(level * 0.9 + 1.5708), rebuild)",
                          "ifElse(gy, 200 + 102 * sin(level * 0.9 + 1.5708), rebuild)",
                          "max(16, 26 - level * 0.7)",
                          "ifElse(0, 1, lives - 0.5)",
                          "pol * ifElse(1, -1, edge)",
                          "ifElse(flashT + 1, 0, edge)",
                          "ifElse(m1x, 200 + 92 * cos(level * 0.9), rebuild)",
                          "ifElse(m1y, 200 + 74 * sin(level * 0.9), rebuild)",
                          "ifElse(m2x, 200 - 92 * cos(level * 0.9), rebuild)",
                          "ifElse(m2y, 200 - 74 * sin(level * 0.9), rebuild)"
