                    "0",
                    "1",
                    "0",
                    "0"
                  ],
                  "count": 1
                }
              },
              {
                "createParticles": {
                  "id": "h1",
                  "variables": [
                    "h1x",
                    "h1y",
                    "h1vx",
                    "h1vy",
