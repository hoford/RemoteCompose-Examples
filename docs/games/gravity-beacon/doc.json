                            }
                          },
                          {
                            "drawCircle": {
                              "cx": "@h1x",
                              "cy": "@h1y",
                              "radius": 9
                            }
                          }
                        ]
                      }
                    },
                    {
                      "particlesLoop": {
                        "system": "@h2",
                        "equations": [
