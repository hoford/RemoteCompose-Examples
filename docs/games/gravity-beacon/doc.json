                              "cy": "@gy",
                              "radius": "@gr"
                            }
                          },
                          {
                            "paint": {
                              "color": "#FF7CE0FF",
                              "style": "fill"
                            }
                          },
                          {
                            "drawCircle": {
                              "cx": "@gx",
                              "cy": "@gy",
                              "radius": 4
                            }
                          },
                          {
                            "conditionalOperations": {
                              "condition": "lt",
                              "v1": "@beaconT",
                              "v2": 45,
                              "commands": [
                                {
                                  "paint": {
                                    "color": "#FF2B2F6B",
                                    "style": "stroke",
                                    "strokeWidth": 2
                                  }
                                },
                                {
                                  "drawCircle": {
                                    "cx": "@tapX",
                                    "cy": "@tapY",
                                    "radius": "(45 - beaconT) * 1.4 + 6"
                                  }
                                },
                                {
                                  "paint": {
                                    "color": "#FF6C6CF0",
                                    "style": "stroke",
                                    "strokeWidth": 2
                                  }
                                },
                                {
                                  "drawCircle": {
                                    "cx": "@tapX",
                                    "cy": "@tapY",
                                    "radius": "(45 - beaconT) * 0.7 + 4"
                                  }
                                },
                                {
                                  "paint": {
                                    "color": "#FFAEB6FF",
                                    "style": "fill"
                                  }
                                },
                                {
                                  "drawCircle": {
                                    "cx": "@tapX",
                                    "cy": "@tapY",
                                    "radius": 4
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "particlesLoop": {
                        "system": "@h1",
                        "equations": [
                          "ifElse(min(max(h1x + h1vx * spd * alive, 21), 379), 200 + 92 * cos(level * 1.7 + 0), rebuild)",
                          "ifElse(min(max(h1y + h1vy * spd * alive, 65), 335), 200 + 82 * sin(level * 1.7 + 0), rebuild)",
                          "ifElse(abs(h1vx) * h1ox + h1vx * (1 - abs(h1ox)), cos(level * 2.3 + 0) * 1.4, rebuild)",
                          "ifElse(abs(h1vy) * h1oy + h1vy * (1 - abs(h1oy)), sin(level * 2.3 + 0) * 1.4, rebuild)",
                          "ifElse(0, 1, 21.5 - h1x) - ifElse(0, 1, h1x - 378.5)",
                          "ifElse(0, 1, 65.5 - h1y) - ifElse(0, 1, h1y - 334.5)",
                          "ifElse(0, 1, 19 - hypot(bx - h1x, by - h1y))"
                        ],
                        "commands": [
                          {
                            "paint": {
                              "color": "#FF3A1220",
                              "style": "fill"
                            }
                          },
                          {
                            "drawCircle": {
