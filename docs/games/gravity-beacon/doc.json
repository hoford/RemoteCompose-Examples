                                    "style": "fill"
                                  }
                                },
                                {
                                  "drawCircle": {
                                    "cx": "@h2x",
                                    "cy": "@h2y",
                                    "radius": 13
                                  }
                                },
                                {
                                  "paint": {
                                    "color": "#FFFF4D6D",
                                    "style": "fill"
                                  }
                                },
                                {
                                  "drawCircle": {
                                    "cx": "@h2x",
                                    "cy": "@h2y",
                                    "radius": 9
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "particlesLoop": {
                        "system": "@ball",
                        "equations": [
                          "ifElse(min(max(bx + bvx * alive, 22), 378), 200 - 132 * cos(level * 2.4), respawn)",
                          "ifElse(min(max(by + bvy * alive, 66), 334), 200 - 105 * sin(level * 2.4), respawn)",
                          "ifElse((abs((bvx * 0.99 + bimp * (tapX - bx))) * bolx + (bvx * 0.99 + bimp * (tapX - bx)) * (1 - abs(bolx))) * bsc, 0, respawn)",
                          "ifElse((abs((bvy * 0.99 + bimp * (tapY - by))) * boly + (bvy * 0.99 + bimp * (tapY - by)) * (1 - abs(boly))) * bsc, 0, respawn)",
                          "ifElse(0, 1, 22.5 - bx) - ifElse(0, 1, bx - 377.5)",
                          "ifElse(0, 1, 66.5 - by) - ifElse(0, 1, by - 333.5)",
                          "max(hypot(bx - tapX, by - tapY), 1)",
                          "ifElse(0, 1, 45 - beaconT) * 25 / (max(bd, 40) * bd)",
                          "hypot(bvx, bvy)",
                          "min(1, 5 / max(bsp, 0.01))",
                          "ifElse(0, 1, gr - 2 - hypot(bx - gx, by - gy))",
                          "max(h1t, h2t)"
                        ],
                        "commands": [
                          {
                            "paint": {
                              "color": "#FF1E4E7A",
                              "style": "fill"
                            }
                          },
