                          "ifElse(min(max(h2y + h2vy * spd * alive, 65), 335), 200 + 82 * sin(level * 1.7 + 3.1), rebuild)",
                          "ifElse(abs(h2vx) * h2ox + h2vx * (1 - abs(h2ox)), cos(level * 2.3 + 3.1) * 1.4, rebuild)",
                          "ifElse(abs(h2vy) * h2oy + h2vy * (1 - abs(h2oy)), sin(level * 2.3 + 3.1) * 1.4, rebuild)",
                          "ifElse(0, 1, 21.5 - h2x) - ifElse(0, 1, h2x - 378.5)",
                          "ifElse(0, 1, 65.5 - h2y) - ifElse(0, 1, h2y - 334.5)",
                          "ifElse(0, 1, level - 1.5) * ifElse(0, 1, 19 - hypot(bx - h2x, by - h2y))"
                        ],
                        "commands": [
                          {
                            "conditionalOperations": {
                              "condition": "gt",
                              "v1": "@level",
                              "v2": 1.5,
