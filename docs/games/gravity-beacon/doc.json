              {
                "impulseProcess": {
                  "commands": [
                    {
                      "particlesLoop": {
                        "system": "@st",
                        "equations": [
                          "sign(max(0, touchTime - animationTime + 0.15)) * ifElse(0, 1, touchTime)",
                          "touch",
                          "touch * (1 - prevT)",
                          "ifElse(beaconT + 1, 0, edge)",
                          "ifElse(tapX, touchX, edge)",
                          "ifElse(tapY, touchY, edge)",
                          "level + adv",
                          "ifElse(level, -1, die)",
                          "ifElse(0, 1, abs(level - curLvl) - 0.5)",
                          "1",
                          "die + (1 - started)",
                          "ifElse(grace + 1, 0, rebuild)",
                          "hit * ifElse(0, 1, grace - 30)",
                          "goalHit * (1 - inGoal)",
                          "hitG * (1 - wasHit)",
                          "goalHit",
                          "hitG",
                          "score + adv",
                          "max(0, lives - die)",
                          "1 + level * 0.1",
                          "ifElse(gx, 200 + 132 * cos(level * 2.4), rebuild)",
                          "ifElse(gy, 200 + 105 * sin(level * 2.4), rebuild)",
                          "max(15, 26 - level * 0.9)",
                          "ifElse(0, 1, lives - 0.5)"
