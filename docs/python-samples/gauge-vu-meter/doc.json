            {
              "type": "draw_text_anchored",
              "text": "VU",
              "x": 200,
              "y": 85,
              "pan_x": 0,
              "pan_y": 0,
              "paint": {
                "color": "#FF333333",
                "text_size": 28
              },
              "_comment": "VU label"
            },
            {
              "type": "draw_arc",
              "left": 50,
              "top": 80,
              "right": 350,
              "bottom": 380,
              "start_angle": 220,
              "sweep_angle": 55,
              "use_center": false,
              "paint": {
                "color": "#FF2E7D32",
                "style": "stroke",
                "stroke_width": 12
              },
              "_comment": "Green zone arc (-20 to 0 VU)"
            },
            {
              "type": "draw_arc",
              "left": 50,
              "top": 80,
              "right": 350,
              "bottom": 380,
              "start_angle": 275,
              "sweep_angle": 15,
              "use_center": false,
              "paint": {
                "color": "#FFFFC107",
                "style": "stroke",
                "stroke_width": 12
