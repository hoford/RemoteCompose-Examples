{
  "header": {
    "width": 400,
    "height": 400,
    "description": "VU Meter Gauge"
  },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "canvas",
          "modifier": {
            "fill_max_size": true,
            "background": "#FF1A1008"
          },
          "children": [
            {
              "type": "float_expression",
              "label": "level",
              "expr": "abs(sin(time.seconds * 3)) * 90"
            },
            {
              "type": "float_expression",
              "label": "needleAngle",
              "expr": "abs(sin(time.seconds * 3)) * 90 / 90 * 80 - 40"
            },
            {
              "type": "draw_round_rect",
              "left": 20,
              "top": 40,
              "right": 380,
              "bottom": 340,
              "rx": 16,
              "ry": 16,
              "paint": {
                "color": "#FFF5ECD5",
                "style": "fill"
              },
              "_comment": "Meter housing"
            },
            {
              "type": "draw_round_rect",
              "left": 20,
              "top": 40,
              "right": 380,
              "bottom": 340,
              "rx": 16,
              "ry": 16,
              "paint": {
                "color": "#FF8B7355",
                "style": "stroke",
                "stroke_width": 4
              }
            },
            {
              "type": "draw_round_rect",
              "left": 35,
              "top": 55,
              "right": 365,
              "bottom": 325,
              "rx": 10,
              "ry": 10,
              "paint": {
                "color": "#FFFFFBE6",
