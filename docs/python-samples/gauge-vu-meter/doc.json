              "x": 200,
              "y": 120,
              "pan_x": 0,
              "pan_y": 0,
              "paint": {
                "color": "#FF333333",
                "text_size": 11
              }
            },
            {
              "type": "restore"
            },
            {
              "type": "save"
            },
            {
