              }
            },
            {
              "type": "restore"
            },
            {
              "type": "save"
            },
            {
              "type": "rotate",
              "angle": 260,
              "cx": 200,
              "cy": 280
            },
            {
              "type": "draw_text_anchored",
              "text": "-7",
              "x": 200,
              "y": 120,
              "pan_x": 0,
              "pan_y": 0,
              "paint": {
                "color": "#FF333333",
                "text_size": 11
              }
            },
            {
              "type": "restore"
            },
            {
              "type": "save"
            },
            {
              "type": "rotate",
              "angle": 275,
              "cx": 200,
              "cy": 280
            },
            {
              "type": "draw_text_anchored",
              "text": "0",
              "x": 200,
              "y": 120,
              "pan_x": 0,
              "pan_y": 0,
              "paint": {
                "color": "#FFC62828",
                "text_size": 13
              }
            },
            {
              "type": "restore"
            },
            {
              "type": "save"
            },
            {
              "type": "rotate",
              "angle": 295,
              "cx": 200,
              "cy": 280
            },
            {
              "type": "draw_text_anchored",
              "text": "+1",
              "x": 200,
              "y": 120,
              "pan_x": 0,
              "pan_y": 0,
              "paint": {
                "color": "#FFC62828",
                "text_size": 11
              }
            },
            {
              "type": "restore"
            },
            {
              "type": "save"
            },
            {
              "type": "rotate",
