              "paint": {
                "color": "#FFC62828",
                "style": "stroke",
                "stroke_width": 12
              },
              "_comment": "Red zone arc (+1 to +3 VU)"
            },
            {
              "type": "loop",
              "from": 0,
              "step": 8,
              "until": 88,
              "label": "vtick",
              "children": [
                {
                  "type": "float_expression",
                  "label": "vAngle",
                  "expr": "$vtick / 90 * 80 + 220"
                },
                {
                  "type": "save"
                },
                {
                  "type": "rotate",
                  "angle": "$vAngle",
                  "cx": 200,
                  "cy": 280
                },
                {
                  "type": "draw_line",
                  "x1": 200,
                  "y1": 97,
                  "x2": 200,
                  "y2": 110,
                  "paint": {
                    "color": "#FF333333",
                    "style": "stroke",
                    "stroke_width": 1.5
                  }
                },
                {
                  "type": "restore"
                }
              ],
              "_comment": "Scale tick marks"
            },
            {
              "type": "save",
