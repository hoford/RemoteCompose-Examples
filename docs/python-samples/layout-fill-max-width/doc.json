{
  "header": { "width": 600, "height": 400, "description": "Fill Max Width Row" },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "row",
          "h_align": "start",
          "v_align": "center",
          "modifier": { "fill_max_size": true, "background": "#FFF0F0F0" },
          "children": [
            {
              "type": "box",
              "modifier": {
                "size": [80, 80],
                "background": "#FF4CAF50",
                "padding": 8
              },
              "children": [
                { "type": "text", "value": "A", "font_size": 24, "color": "#FFFFFFFF" }
              ]
            },
            {
              "type": "box",
              "modifier": {
                "fill_max_width": true,
                "horizontal_weight": 1.0,
                "size": [0, 80],
                "background": "#FF2196F3",
                "padding": 8
              },
              "children": [
                { "type": "text", "value": "Fills Remaining", "font_size": 20, "color": "#FFFFFFFF" }
              ]
            },
            {
              "type": "box",
              "modifier": {
                "size": [80, 80],
                "background": "#FFFF9800",
                "padding": 8
              },
              "children": [
                { "type": "text", "value": "C", "font_size": 24, "color": "#FFFFFFFF" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
