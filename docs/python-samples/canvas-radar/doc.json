{
  "_comment": "Simple radar/spider chart outline (hexagonal) with data shape",
  "header": { "width": 400, "height": 400, "description": "CanvasRadar" },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "canvas",
          "modifier": { "fill_max_size": true, "background": "#FFFFFFFF" },
          "children": [
            { "_comment": "Title",
              "type": "paint", "color": "#FF212121", "text_size": 16.0, "style": "fill" },
            { "type": "draw_text_anchored", "text": "Skill Assessment", "x": 200, "y": 22, "pan_x": 0, "pan_y": 0 },

            { "_comment": "Outer hexagon (r=150, center 200,210)",
              "type": "paint", "color": "#FFE0E0E0", "stroke_width": 1.5, "style": "stroke" },
            { "type": "draw_line", "x1": 200, "y1": 60, "x2": 330, "y2": 135 },
            { "type": "draw_line", "x1": 330, "y1": 135, "x2": 330, "y2": 285 },
            { "type": "draw_line", "x1": 330, "y1": 285, "x2": 200, "y2": 360 },
            { "type": "draw_line", "x1": 200, "y1": 360, "x2": 70, "y2": 285 },
            { "type": "draw_line", "x1": 70, "y1": 285, "x2": 70, "y2": 135 },
            { "type": "draw_line", "x1": 70, "y1": 135, "x2": 200, "y2": 60 },

            { "_comment": "Middle hexagon (r=100). Scale=0.667 from center",
              "type": "draw_line", "x1": 200, "y1": 110, "x2": 287, "y2": 160 },
            { "type": "draw_line", "x1": 287, "y1": 160, "x2": 287, "y2": 260 },
            { "type": "draw_line", "x1": 287, "y1": 260, "x2": 200, "y2": 310 },
            { "type": "draw_line", "x1": 200, "y1": 310, "x2": 113, "y2": 260 },
            { "type": "draw_line", "x1": 113, "y1": 260, "x2": 113, "y2": 160 },
            { "type": "draw_line", "x1": 113, "y1": 160, "x2": 200, "y2": 110 },

            { "_comment": "Inner hexagon (r=50). Scale=0.333 from center",
              "type": "draw_line", "x1": 200, "y1": 160, "x2": 243, "y2": 185 },
            { "type": "draw_line", "x1": 243, "y1": 185, "x2": 243, "y2": 235 },
            { "type": "draw_line", "x1": 243, "y1": 235, "x2": 200, "y2": 260 },
            { "type": "draw_line", "x1": 200, "y1": 260, "x2": 157, "y2": 235 },
            { "type": "draw_line", "x1": 157, "y1": 235, "x2": 157, "y2": 185 },
            { "type": "draw_line", "x1": 157, "y1": 185, "x2": 200, "y2": 160 },

            { "_comment": "Spokes from center to outer vertices",
              "type": "paint", "color": "#FFBDBDBD", "stroke_width": 1.0, "style": "stroke" },
            { "type": "draw_line", "x1": 200, "y1": 210, "x2": 200, "y2": 60 },
            { "type": "draw_line", "x1": 200, "y1": 210, "x2": 330, "y2": 135 },
            { "type": "draw_line", "x1": 200, "y1": 210, "x2": 330, "y2": 285 },
            { "type": "draw_line", "x1": 200, "y1": 210, "x2": 200, "y2": 360 },
            { "type": "draw_line", "x1": 200, "y1": 210, "x2": 70, "y2": 285 },
            { "type": "draw_line", "x1": 200, "y1": 210, "x2": 70, "y2": 135 },

            { "_comment": "Data fill (polygon values: 90%,70%,85%,50%,75%,60%)",
              "type": "paint", "color": "#331976D2", "style": "fill" },

            { "_comment": "Data outline",
              "type": "paint", "color": "#FF1976D2", "stroke_width": 2.5, "style": "stroke" },
            { "type": "draw_line", "x1": 200, "y1": 75, "x2": 291, "y2": 152 },
            { "type": "draw_line", "x1": 291, "y1": 152, "x2": 310, "y2": 274 },
            { "type": "draw_line", "x1": 310, "y1": 274, "x2": 200, "y2": 285 },
            { "type": "draw_line", "x1": 200, "y1": 285, "x2": 103, "y2": 266 },
            { "type": "draw_line", "x1": 103, "y1": 266, "x2": 92, "y2": 165 },
            { "type": "draw_line", "x1": 92, "y1": 165, "x2": 200, "y2": 75 },

            { "_comment": "Data points",
              "type": "paint", "color": "#FF0D47A1", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 75, "radius": 4 },
            { "type": "draw_circle", "cx": 291, "cy": 152, "radius": 4 },
            { "type": "draw_circle", "cx": 310, "cy": 274, "radius": 4 },
            { "type": "draw_circle", "cx": 200, "cy": 285, "radius": 4 },
            { "type": "draw_circle", "cx": 103, "cy": 266, "radius": 4 },
            { "type": "draw_circle", "cx": 92, "cy": 165, "radius": 4 },

            { "_comment": "Axis labels",
              "type": "paint", "color": "#FF424242", "text_size": 12.0, "style": "fill" },
            { "type": "draw_text_anchored", "text": "Speed", "x": 200, "y": 48, "pan_x": 0, "pan_y": 1 },
            { "type": "draw_text_anchored", "text": "Power", "x": 342, "y": 130, "pan_x": -1, "pan_y": 0 },
            { "type": "draw_text_anchored", "text": "Range", "x": 342, "y": 290, "pan_x": -1, "pan_y": 0 },
            { "type": "draw_text_anchored", "text": "Cost", "x": 200, "y": 378, "pan_x": 0, "pan_y": -1 },
            { "type": "draw_text_anchored", "text": "Safety", "x": 58, "y": 290, "pan_x": 1, "pan_y": 0 },
            { "type": "draw_text_anchored", "text": "Comfort", "x": 58, "y": 130, "pan_x": 1, "pan_y": 0 }
          ]
        }
      ]
    }
  ]
}
