{
  "_comment": "Bullseye target with alternating red and white rings",
  "header": { "width": 400, "height": 400, "description": "CanvasTarget" },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "canvas",
          "modifier": { "fill_max_size": true, "background": "#FFE8E8E8" },
          "children": [
            { "type": "paint", "color": "#FFDD2C00", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 200, "radius": 180 },

            { "type": "paint", "color": "#FFFFFFFF", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 200, "radius": 156 },

            { "type": "paint", "color": "#FFDD2C00", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 200, "radius": 132 },

            { "type": "paint", "color": "#FFFFFFFF", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 200, "radius": 108 },

            { "type": "paint", "color": "#FFDD2C00", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 200, "radius": 84 },

            { "type": "paint", "color": "#FFFFFFFF", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 200, "radius": 60 },

            { "type": "paint", "color": "#FFDD2C00", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 200, "radius": 36 },

            { "_comment": "Bullseye center",
              "type": "paint", "color": "#FFFFF176", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 200, "radius": 12 },

            { "_comment": "Crosshair lines",
              "type": "paint", "color": "#FF000000", "stroke_width": 1.5, "style": "stroke" },
            { "type": "draw_line", "x1": 200, "y1": 10, "x2": 200, "y2": 390 },
            { "type": "draw_line", "x1": 10, "y1": 200, "x2": 390, "y2": 200 }
          ]
        }
      ]
    }
  ]
}
