{
  "_comment": "Simple clock face with second hand rotating based on time.seconds",
  "header": {
    "width": 400,
    "height": 400,
    "description": "AnimClockSimple"
  },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "canvas",
          "modifier": {
            "fill_max_size": true
          },
          "children": [
            {
              "type": "viewport",
              "width": 400,
              "height": 400,
              "children": [
                {
                  "type": "float_expression",
                  "label": "w",
                  "expr": "400"
                },
                {
                  "type": "float_expression",
                  "label": "h",
                  "expr": "400"
                },
                {
                  "type": "float_expression",
                  "label": "cx",
                  "expr": "$w / 2"
                },
                {
                  "type": "float_expression",
                  "label": "cy",
                  "expr": "$h / 2"
                },
                {
                  "type": "float_expression",
                  "label": "r",
                  "expr": "min($w, $h) / 2 - 30"
                },
                {
                  "type": "draw_rect",
                  "paint": {
                    "color": "#FF2D2D44",
                    "style": "fill"
                  },
                  "left": 0,
                  "top": 0,
                  "right": "$w",
                  "bottom": "$h"
                },
                {
                  "_comment": "Clock face background",
                  "type": "draw_circle",
                  "paint": {
                    "color": "#FF3D3D5C",
                    "style": "fill"
                  },
                  "cx": "$cx",
                  "cy": "$cy",
                  "radius": "$r"
                },
                {
                  "type": "draw_circle",
                  "paint": {
                    "color": "#FFFFFFFF",
                    "style": "stroke",
                    "stroke_width": 3.0
                  },
                  "cx": "$cx",
                  "cy": "$cy",
                  "radius": "$r"
                },
                {
                  "_comment": "Hour tick marks \u2014 12 ticks around the face",
                  "type": "paint",
                  "color": "#FFFFFFFF",
                  "style": "stroke",
                  "stroke_width": 3.0
                },
                {
                  "type": "loop",
                  "from": 0,
                  "step": 30,
                  "until": 360,
                  "label": "tick",
                  "children": [
                    {
                      "type": "save"
                    },
                    {
                      "type": "rotate",
                      "angle": "$tick",
                      "cx": "$cx",
                      "cy": "$cy"
                    },
                    {
                      "type": "float_expression",
                      "label": "t_start",
                      "expr": "$cy - $r + 10"
                    },
                    {
                      "type": "float_expression",
                      "label": "t_end",
                      "expr": "$cy - $r + 25"
                    },
                    {
                      "type": "draw_line",
                      "x1": "$cx",
                      "y1": "$t_start",
                      "x2": "$cx",
                      "y2": "$t_end"
                    },
                    {
                      "type": "restore"
                    }
                  ]
                },
                {
                  "_comment": "Minute hand \u2014 driven by CONTINUOUS_SEC scaled to minutes",
                  "type": "float_expression",
                  "label": "min_angle",
                  "expr": "time.seconds * 0.1 % 360"
                },
                {
                  "type": "save"
                },
                {
                  "type": "rotate",
                  "angle": "$min_angle",
                  "cx": "$cx",
                  "cy": "$cy"
                },
                {
                  "type": "draw_line",
                  "paint": {
                    "color": "#FFFFFFFF",
                    "style": "stroke",
                    "stroke_width": 4.0
                  },
                  "x1": "$cx",
                  "y1": "$cy",
                  "x2": "$cx",
                  "y2": {
                    "expr": "$cy - $r * 0.7"
                  }
                },
                {
                  "type": "restore"
                },
                {
                  "_comment": "Second hand \u2014 continuous rotation, 6 degrees per second",
                  "type": "float_expression",
                  "label": "sec_angle",
                  "expr": "time.seconds * 6 % 360"
                },
                {
                  "type": "save"
                },
                {
                  "type": "rotate",
                  "angle": "$sec_angle",
                  "cx": "$cx",
                  "cy": "$cy"
                },
                {
                  "type": "draw_line",
                  "paint": {
                    "color": "#FFFF5252",
                    "style": "stroke",
                    "stroke_width": 2.0
                  },
                  "x1": "$cx",
                  "y1": {
                    "expr": "$cy + 20"
                  },
                  "x2": "$cx",
                  "y2": {
                    "expr": "$cy - $r * 0.85"
                  }
                },
                {
                  "type": "restore"
                },
                {
                  "_comment": "Center cap",
                  "type": "draw_circle",
                  "paint": {
                    "color": "#FFFF5252",
                    "style": "fill"
                  },
                  "cx": "$cx",
                  "cy": "$cy",
                  "radius": 6
                },
                {
                  "type": "draw_circle",
                  "paint": {
                    "color": "#FFFFFFFF",
                    "style": "fill"
                  },
                  "cx": "$cx",
                  "cy": "$cy",
                  "radius": 3
                },
                {
                  "_comment": "Digital seconds display",
                  "type": "float_expression",
                  "label": "sec_val",
                  "expr": "time.seconds * 6 % 360 / 6"
                },
                {
                  "type": "text_from_float",
                  "label": "sec_txt",
                  "value": "$sec_val",
                  "before": 2,
                  "after": 1,
                  "flags": 1
                },
                {
                  "type": "paint",
                  "color": "#80FFFFFF",
                  "text_size": 14.0,
                  "style": "fill"
                },
                {
                  "type": "draw_text_anchored",
                  "text_id": "$sec_txt",
                  "x": "$cx",
                  "y": {
                    "expr": "$cy + $r * 0.4"
                  },
                  "pan_x": 0,
                  "pan_y": 0
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
