{
  "_comment": "Canvas drawing with various shapes — rect, circle, oval, round_rect, arc, line",
  "header": { "width": 500, "height": 500, "description": "CanvasShapes" },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "canvas",
          "modifier": { "fill_max_size": true, "background": "#FFFFFFFF" },
          "children": [
            { "type": "paint", "color": "#FFFF0000", "style": "fill" },
            { "type": "draw_rect", "left": 20, "top": 20, "right": 120, "bottom": 80 },

            { "type": "paint", "color": "#FF00AA00", "style": "fill" },
            { "type": "draw_circle", "cx": 200, "cy": 50, "radius": 40 },

            { "type": "paint", "color": "#FF0000FF", "style": "fill" },
            { "type": "draw_oval", "left": 280, "top": 20, "right": 400, "bottom": 80 },

            { "type": "paint", "color": "#FFFF8800", "style": "fill" },
            { "type": "draw_round_rect", "left": 20, "top": 120, "right": 200, "bottom": 220, "rx": 20, "ry": 20 },

            { "type": "paint", "color": "#FF8800FF", "style": "stroke", "stroke_width": 4.0 },
            { "type": "draw_arc", "left": 220, "top": 120, "right": 400, "bottom": 300, "start_angle": 0, "sweep_angle": 270 },

            { "type": "paint", "color": "#FF000000", "stroke_width": 3.0, "style": "stroke" },
            { "type": "draw_line", "x1": 20, "y1": 350, "x2": 480, "y2": 350 },
            { "type": "draw_line", "x1": 20, "y1": 380, "x2": 480, "y2": 380 },
            { "type": "draw_line", "x1": 20, "y1": 410, "x2": 480, "y2": 410 }
          ]
        }
      ]
    }
  ]
}
