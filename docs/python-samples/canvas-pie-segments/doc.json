{
  "_comment": "4-segment pie chart using draw_sector",
  "header": { "width": 400, "height": 400, "description": "CanvasPieSegments" },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "canvas",
          "modifier": { "fill_max_size": true, "background": "#FFFFFFFF" },
          "children": [
            { "_comment": "Title",
              "type": "paint", "color": "#FF212121", "text_size": 18.0, "style": "fill" },
            { "type": "draw_text_anchored", "text": "Revenue by Quarter", "x": 200, "y": 25, "pan_x": 0, "pan_y": 0 },

            { "_comment": "Q1 - 35% = 126 degrees",
              "type": "paint", "color": "#FF1565C0", "style": "fill" },
            { "type": "draw_sector", "left": 60, "top": 60, "right": 340, "bottom": 340, "start_angle": 0, "sweep_angle": 126 },

            { "_comment": "Q2 - 25% = 90 degrees",
              "type": "paint", "color": "#FF43A047", "style": "fill" },
            { "type": "draw_sector", "left": 60, "top": 60, "right": 340, "bottom": 340, "start_angle": 126, "sweep_angle": 90 },

            { "_comment": "Q3 - 22% = 79.2 degrees",
              "type": "paint", "color": "#FFFFA000", "style": "fill" },
            { "type": "draw_sector", "left": 60, "top": 60, "right": 340, "bottom": 340, "start_angle": 216, "sweep_angle": 79.2 },

            { "_comment": "Q4 - 18% = 64.8 degrees",
              "type": "paint", "color": "#FFE53935", "style": "fill" },
            { "type": "draw_sector", "left": 60, "top": 60, "right": 340, "bottom": 340, "start_angle": 295.2, "sweep_angle": 64.8 },

            { "_comment": "Segment outlines",
              "type": "paint", "color": "#FFFFFFFF", "stroke_width": 3.0, "style": "stroke" },
            { "type": "draw_sector", "left": 60, "top": 60, "right": 340, "bottom": 340, "start_angle": 0, "sweep_angle": 126 },
            { "type": "draw_sector", "left": 60, "top": 60, "right": 340, "bottom": 340, "start_angle": 126, "sweep_angle": 90 },
            { "type": "draw_sector", "left": 60, "top": 60, "right": 340, "bottom": 340, "start_angle": 216, "sweep_angle": 79.2 },
            { "type": "draw_sector", "left": 60, "top": 60, "right": 340, "bottom": 340, "start_angle": 295.2, "sweep_angle": 64.8 },

            { "_comment": "Legend",
              "type": "paint", "color": "#FF1565C0", "style": "fill" },
            { "type": "draw_rect", "left": 50, "top": 360, "right": 66, "bottom": 376 },
            { "type": "paint", "color": "#FF43A047", "style": "fill" },
            { "type": "draw_rect", "left": 140, "top": 360, "right": 156, "bottom": 376 },
            { "type": "paint", "color": "#FFFFA000", "style": "fill" },
            { "type": "draw_rect", "left": 230, "top": 360, "right": 246, "bottom": 376 },
            { "type": "paint", "color": "#FFE53935", "style": "fill" },
            { "type": "draw_rect", "left": 310, "top": 360, "right": 326, "bottom": 376 },

            { "type": "paint", "color": "#FF424242", "text_size": 12.0, "style": "fill" },
            { "type": "draw_text_anchored", "text": "Q1 35%", "x": 70, "y": 368, "pan_x": -1, "pan_y": 0 },
            { "type": "draw_text_anchored", "text": "Q2 25%", "x": 160, "y": 368, "pan_x": -1, "pan_y": 0 },
            { "type": "draw_text_anchored", "text": "Q3 22%", "x": 250, "y": 368, "pan_x": -1, "pan_y": 0 },
            { "type": "draw_text_anchored", "text": "Q4 18%", "x": 330, "y": 368, "pan_x": -1, "pan_y": 0 }
          ]
        }
      ]
    }
  ]
}
