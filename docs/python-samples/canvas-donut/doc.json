{
  "_comment": "Donut/ring chart using overlapping arcs with stroke style",
  "header": { "width": 400, "height": 400, "description": "CanvasDonut" },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "canvas",
          "modifier": { "fill_max_size": true, "background": "#FF263238" },
          "children": [
            { "_comment": "Title",
              "type": "paint", "color": "#FFFFFFFF", "text_size": 18.0, "style": "fill" },
            { "type": "draw_text_anchored", "text": "Usage Breakdown", "x": 200, "y": 30, "pan_x": 0, "pan_y": 0 },

            { "_comment": "Background ring",
              "type": "paint", "color": "#FF37474F", "stroke_width": 40.0, "style": "stroke" },
            { "type": "draw_arc", "left": 80, "top": 80, "right": 320, "bottom": 320, "start_angle": 0, "sweep_angle": 360, "use_center": false },

            { "_comment": "Segment 1 - Storage 40% = 144 deg",
              "type": "paint", "color": "#FF42A5F5", "stroke_width": 40.0, "style": "stroke" },
            { "type": "draw_arc", "left": 80, "top": 80, "right": 320, "bottom": 320, "start_angle": -90, "sweep_angle": 144, "use_center": false },

            { "_comment": "Segment 2 - Media 25% = 90 deg",
              "type": "paint", "color": "#FF66BB6A", "stroke_width": 40.0, "style": "stroke" },
            { "type": "draw_arc", "left": 80, "top": 80, "right": 320, "bottom": 320, "start_angle": 54, "sweep_angle": 90, "use_center": false },

            { "_comment": "Segment 3 - Apps 20% = 72 deg",
              "type": "paint", "color": "#FFFFCA28", "stroke_width": 40.0, "style": "stroke" },
            { "type": "draw_arc", "left": 80, "top": 80, "right": 320, "bottom": 320, "start_angle": 144, "sweep_angle": 72, "use_center": false },

            { "_comment": "Segment 4 - Other 15% = 54 deg",
              "type": "paint", "color": "#FFEF5350", "stroke_width": 40.0, "style": "stroke" },
            { "type": "draw_arc", "left": 80, "top": 80, "right": 320, "bottom": 320, "start_angle": 216, "sweep_angle": 54, "use_center": false },

            { "_comment": "Center text",
              "type": "paint", "color": "#FFFFFFFF", "text_size": 28.0, "style": "fill" },
            { "type": "draw_text_anchored", "text": "128 GB", "x": 200, "y": 195, "pan_x": 0, "pan_y": 0 },
            { "type": "paint", "color": "#FFB0BEC5", "text_size": 14.0, "style": "fill" },
            { "type": "draw_text_anchored", "text": "Total", "x": 200, "y": 218, "pan_x": 0, "pan_y": 0 },

            { "_comment": "Legend",
              "type": "paint", "color": "#FF42A5F5", "style": "fill" },
            { "type": "draw_circle", "cx": 70, "cy": 355, "radius": 6 },
            { "type": "paint", "color": "#FF66BB6A", "style": "fill" },
            { "type": "draw_circle", "cx": 170, "cy": 355, "radius": 6 },
            { "type": "paint", "color": "#FFFFCA28", "style": "fill" },
            { "type": "draw_circle", "cx": 260, "cy": 355, "radius": 6 },
            { "type": "paint", "color": "#FFEF5350", "style": "fill" },
            { "type": "draw_circle", "cx": 340, "cy": 355, "radius": 6 },

            { "type": "paint", "color": "#FFB0BEC5", "text_size": 11.0, "style": "fill" },
            { "type": "draw_text_anchored", "text": "Storage", "x": 82, "y": 355, "pan_x": -1, "pan_y": 0 },
            { "type": "draw_text_anchored", "text": "Media", "x": 182, "y": 355, "pan_x": -1, "pan_y": 0 },
            { "type": "draw_text_anchored", "text": "Apps", "x": 272, "y": 355, "pan_x": -1, "pan_y": 0 },
            { "type": "draw_text_anchored", "text": "Other", "x": 352, "y": 355, "pan_x": -1, "pan_y": 0 }
          ]
        }
      ]
    }
  ]
}
