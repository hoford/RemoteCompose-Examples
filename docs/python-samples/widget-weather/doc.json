{
  "_comment": "Weather card: city name, animated temperature, 3-day forecast with canvas icons",
  "header": { "width": 400, "height": 300, "description": "WidgetWeather" },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "box",
          "modifier": { "fill_max_size": true, "background": "#FF1565C0", "padding": 16 },
          "children": [
            {
              "type": "column",
              "h_align": "start",
              "v_align": "top",
              "modifier": { "fill_max_size": true },
              "children": [
                { "type": "text", "value": "San Francisco", "font_size": 22, "color": "#FFFFFFFF" },
                { "type": "text", "value": "Partly Cloudy", "font_size": 13, "color": "#B3FFFFFF" },
                {
                  "_comment": "Large animated temperature display",
                  "type": "canvas",
                  "modifier": { "fill_max_width": true, "size": [0, 90] },
                  "children": [
                    { "type": "float_expression", "label": "temp", "expr": "sin(time.seconds * 0.1) * 3 + 18" },
                    { "type": "text_from_float", "label": "temp_txt", "value": "$temp", "before": 2, "after": 1, "flags": 1 },
                    { "type": "paint", "color": "#FFFFFFFF", "text_size": 64.0, "style": "fill" },
                    { "type": "draw_text_anchored", "text_id": "$temp_txt", "x": 10, "y": 55, "pan_x": -1, "pan_y": 0 },
                    { "type": "paint", "color": "#B3FFFFFF", "text_size": 24.0 },
                    { "type": "draw_text_anchored", "text": "C", "x": 160, "y": 25, "pan_x": -1, "pan_y": 0 },
                    { "_comment": "Degree symbol as small circle",
                      "type": "draw_circle",
                      "paint": { "color": "#B3FFFFFF", "style": "stroke", "stroke_width": 2.0 },
                      "cx": 148, "cy": 20, "radius": 5 }
                  ]
                },
                {
                  "_comment": "Divider line",
                  "type": "box",
                  "modifier": { "fill_max_width": true, "size": [0, 1], "background": "#33FFFFFF" },
                  "children": []
                },
                {
                  "_comment": "3-day forecast row",
                  "type": "row",
                  "h_align": "center",
                  "v_align": "top",
                  "modifier": { "fill_max_width": true, "padding": 8 },
                  "children": [
                    {
                      "_comment": "Mon - sunny",
                      "type": "box",
                      "modifier": { "horizontal_weight": 1.0, "padding": 8, "background": "#331A237E", "clip": { "radii": [8, 8, 8, 8] } },
                      "children": [
                        {
                          "type": "column",
                          "h_align": "center",
                          "children": [
                            { "type": "text", "value": "Mon", "font_size": 12, "color": "#B3FFFFFF" },
                            {
                              "type": "canvas",
                              "modifier": { "size": [40, 40] },
                              "children": [
                                { "type": "draw_circle",
                                  "paint": { "color": "#FFFFEB3B", "style": "fill" },
                                  "cx": 20, "cy": 20, "radius": 12 },
                                { "type": "draw_line",
                                  "paint": { "color": "#FFFFEB3B", "style": "stroke", "stroke_width": 2.0 },
                                  "x1": 20, "y1": 2, "x2": 20, "y2": 8 },
                                { "type": "draw_line", "x1": 20, "y1": 32, "x2": 20, "y2": 38 },
                                { "type": "draw_line", "x1": 2, "y1": 20, "x2": 8, "y2": 20 },
                                { "type": "draw_line", "x1": 32, "y1": 20, "x2": 38, "y2": 20 }
                              ]
                            },
                            { "type": "text", "value": "22", "font_size": 16, "color": "#FFFFFFFF" }
                          ]
                        }
                      ]
                    },
                    {
                      "_comment": "Tue - cloudy",
                      "type": "box",
                      "modifier": { "horizontal_weight": 1.0, "padding": 8, "background": "#331A237E", "clip": { "radii": [8, 8, 8, 8] } },
                      "children": [
                        {
                          "type": "column",
                          "h_align": "center",
                          "children": [
                            { "type": "text", "value": "Tue", "font_size": 12, "color": "#B3FFFFFF" },
                            {
                              "type": "canvas",
                              "modifier": { "size": [40, 40] },
                              "children": [
                                { "type": "draw_round_rect",
                                  "paint": { "color": "#FFCFD8DC", "style": "fill" },
                                  "left": 4, "top": 14, "right": 36, "bottom": 30, "rx": 8, "ry": 8 },
                                { "type": "draw_circle",
                                  "paint": { "color": "#FFCFD8DC", "style": "fill" },
                                  "cx": 15, "cy": 14, "radius": 8 },
                                { "type": "draw_circle", "cx": 26, "cy": 12, "radius": 10 }
                              ]
                            },
                            { "type": "text", "value": "17", "font_size": 16, "color": "#FFFFFFFF" }
                          ]
                        }
                      ]
                    },
                    {
                      "_comment": "Wed - rainy",
                      "type": "box",
                      "modifier": { "horizontal_weight": 1.0, "padding": 8, "background": "#331A237E", "clip": { "radii": [8, 8, 8, 8] } },
                      "children": [
                        {
                          "type": "column",
                          "h_align": "center",
                          "children": [
                            { "type": "text", "value": "Wed", "font_size": 12, "color": "#B3FFFFFF" },
                            {
                              "type": "canvas",
                              "modifier": { "size": [40, 40] },
                              "children": [
                                { "type": "draw_round_rect",
                                  "paint": { "color": "#FF90A4AE", "style": "fill" },
                                  "left": 4, "top": 8, "right": 36, "bottom": 22, "rx": 7, "ry": 7 },
                                { "type": "draw_circle",
                                  "paint": { "color": "#FF90A4AE", "style": "fill" },
                                  "cx": 14, "cy": 8, "radius": 7 },
                                { "type": "draw_circle", "cx": 26, "cy": 6, "radius": 9 },
                                { "type": "draw_line",
                                  "paint": { "color": "#FF42A5F5", "stroke_width": 2.0 },
                                  "x1": 12, "y1": 26, "x2": 10, "y2": 34 },
                                { "type": "draw_line", "x1": 20, "y1": 26, "x2": 18, "y2": 34 },
                                { "type": "draw_line", "x1": 28, "y1": 26, "x2": 26, "y2": 34 }
                              ]
                            },
                            { "type": "text", "value": "14", "font_size": 16, "color": "#FFFFFFFF" }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}