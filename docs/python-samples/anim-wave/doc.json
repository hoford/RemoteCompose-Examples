{
  "_comment": "Animated sine wave drawn with a loop of small line segments across screen",
  "header": {
    "width": 400,
    "height": 400,
    "description": "AnimWave"
  },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "canvas",
          "modifier": {
            "fill_max_size": true
          },
          "children": [
            {
              "type": "viewport",
              "width": 400,
              "height": 400,
              "children": [
                {
                  "type": "float_expression",
                  "label": "w",
                  "expr": "400"
                },
                {
                  "type": "float_expression",
                  "label": "h",
                  "expr": "400"
                },
                {
                  "type": "float_expression",
                  "label": "cy",
                  "expr": "$h / 2"
                },
                {
                  "type": "draw_rect",
                  "paint": {
                    "color": "#FF1A1A2E",
                    "style": "fill"
                  },
                  "left": 0,
                  "top": 0,
                  "right": "$w",
                  "bottom": "$h"
                },
                {
                  "_comment": "Horizontal axis",
                  "type": "draw_line",
                  "paint": {
                    "color": "#30FFFFFF",
                    "stroke_width": 1.0
                  },
                  "x1": 0,
                  "y1": "$cy",
                  "x2": "$w",
                  "y2": "$cy"
                },
                {
                  "_comment": "Wave 1 \u2014 primary cyan wave",
                  "type": "paint",
                  "color": "#FF00E5FF",
                  "style": "stroke",
                  "stroke_width": 3.0
                },
                {
                  "type": "loop",
                  "from": 0,
                  "step": 8,
                  "until": 392,
                  "label": "x1",
                  "children": [
                    {
                      "type": "float_expression",
                      "label": "x1a",
                      "expr": "$x1"
                    },
                    {
                      "type": "float_expression",
                      "label": "x1b",
                      "expr": "$x1 + 8"
                    },
                    {
                      "type": "float_expression",
                      "label": "y1a",
                      "expr": "$cy + sin($x1 * 0.03 + time.seconds * 3) * 80"
                    },
                    {
                      "type": "float_expression",
                      "label": "y1b",
                      "expr": "$cy + sin($x1b * 0.03 + time.seconds * 3) * 80"
                    },
                    {
                      "type": "draw_line",
                      "x1": "$x1a",
                      "y1": "$y1a",
                      "x2": "$x1b",
                      "y2": "$y1b"
                    }
                  ]
                },
                {
                  "_comment": "Wave 2 \u2014 secondary magenta wave, phase shifted",
                  "type": "paint",
                  "color": "#80E040FB",
                  "style": "stroke",
                  "stroke_width": 2.0
                },
                {
                  "type": "loop",
                  "from": 0,
                  "step": 8,
                  "until": 392,
                  "label": "x2",
                  "children": [
                    {
                      "type": "float_expression",
                      "label": "x2a",
                      "expr": "$x2"
                    },
                    {
                      "type": "float_expression",
                      "label": "x2b",
                      "expr": "$x2 + 8"
                    },
                    {
                      "type": "float_expression",
                      "label": "y2a",
                      "expr": "$cy + sin($x2 * 0.05 + time.seconds * 2 + 1.5) * 50"
                    },
                    {
                      "type": "float_expression",
                      "label": "y2b",
                      "expr": "$cy + sin($x2b * 0.05 + time.seconds * 2 + 1.5) * 50"
                    },
                    {
                      "type": "draw_line",
                      "x1": "$x2a",
                      "y1": "$y2a",
                      "x2": "$x2b",
                      "y2": "$y2b"
                    }
                  ]
                },
                {
                  "_comment": "Wave 3 \u2014 subtle green undertone",
                  "type": "paint",
                  "color": "#4000E676",
                  "style": "stroke",
                  "stroke_width": 1.5
                },
                {
                  "type": "loop",
                  "from": 0,
                  "step": 8,
                  "until": 392,
                  "label": "x3",
                  "children": [
                    {
                      "type": "float_expression",
                      "label": "x3a",
                      "expr": "$x3"
                    },
                    {
                      "type": "float_expression",
                      "label": "x3b",
                      "expr": "$x3 + 8"
                    },
                    {
                      "type": "float_expression",
                      "label": "y3a",
                      "expr": "$cy + sin($x3 * 0.02 + time.seconds * 1.5 + 3.0) * 120"
                    },
                    {
                      "type": "float_expression",
                      "label": "y3b",
                      "expr": "$cy + sin($x3b * 0.02 + time.seconds * 1.5 + 3.0) * 120"
                    },
                    {
                      "type": "draw_line",
                      "x1": "$x3a",
                      "y1": "$y3a",
                      "x2": "$x3b",
                      "y2": "$y3b"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
