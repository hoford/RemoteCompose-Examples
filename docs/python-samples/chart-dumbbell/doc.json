            {"type": "paint", "color": "#FF9E9E9E", "style": "fill", "stroke_width": 1, "text_size": 9},
            {"type": "draw_circle", "cx": 140, "cy": 48, "radius": 5},
            {"type": "draw_text_anchored", "text": "Before", "x": 150, "y": 48, "pan_x": -1, "pan_y": 0},
