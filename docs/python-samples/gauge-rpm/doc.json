{
  "header": {
    "width": 400,
    "height": 400,
    "description": "RPM Tachometer Gauge"
  },
  "ops": [
    {
      "type": "root",
      "children": [
        {
          "type": "canvas",
          "modifier": {
            "fill_max_size": true,
            "background": "#FF0D0D14"
          },
          "children": [
            {
              "type": "float_expression",
              "label": "rpm",
              "expr": "sin(time.seconds * 0.7) * 3000 + 4000"
            },
            {
              "type": "float_expression",
              "label": "needleAngle",
              "expr": "(sin(time.seconds * 0.7) * 3000 + 4000) / 8000 * 270 - 225"
            },
            {
              "type": "draw_circle",
              "cx": 200,
              "cy": 200,
              "radius": 190,
              "paint": {
                "color": "#FF1A1A24",
                "style": "fill"
              },
              "_comment": "Outer bezel"
            },
            {
              "type": "draw_circle",
              "cx": 200,
              "cy": 200,
              "radius": 190,
              "paint": {
                "color": "#FF444455",
                "style": "stroke",
                "stroke_width": 3
              }
            },
            {
              "type": "draw_circle",
              "cx": 200,
              "cy": 200,
              "radius": 175,
              "paint": {
                "color": "#FF0A0A12",
                "style": "fill"
              },
              "_comment": "Inner face"
            },
            {
              "type": "draw_arc",
              "left": 40,
              "top": 40,
              "right": 360,
              "bottom": 360,
              "start_angle": 135,
              "sweep_angle": 270,
              "use_center": false,
              "paint": {
                "color": "#22FFFFFF",
                "style": "stroke",
                "stroke_width": 14
              },
              "_comment": "Main arc track"
            },
            {
              "type": "draw_arc",
              "left": 40,
              "top": 40,
              "right": 360,
              "bottom": 360,
              "start_angle": 337.5,
              "sweep_angle": 67.5,
              "use_center": false,
              "paint": {
                "color": "#88FF1744",
                "style": "stroke",
                "stroke_width": 14
              },
              "_comment": "Red zone (6000-8000 RPM = last 67.5 degrees of sweep)"
            },
            {
              "type": "loop",
              "from": 6,
              "step": 1,
              "until": 9,
              "label": "rz",
              "children": [
                {
                  "type": "float_expression",
                  "label": "rzAngle",
                  "expr": "$rz / 8 * 270 + 135"
                },
                {
                  "type": "save"
                },
                {
                  "type": "rotate",
                  "angle": "$rzAngle",
                  "cx": 200,
                  "cy": 200
                },
                {
                  "type": "draw_line",
                  "x1": 200,
                  "y1": 20,
                  "x2": 200,
                  "y2": 55,
                  "paint": {
                    "color": "#44FF1744",
                    "style": "stroke",
                    "stroke_width": 1
                  }
                },
                {
                  "type": "restore"
                }
              ],
              "_comment": "Red zone fill pattern lines"
            },
            {
              "type": "loop",
              "from": 0,
              "step": 1,
              "until": 9,
              "label": "k",
              "children": [
                {
                  "type": "float_expression",
                  "label": "kAngle",
                  "expr": "$k / 8 * 270 + 135"
                },
                {
                  "type": "save"
                },
                {
                  "type": "rotate",
                  "angle": "$kAngle",
                  "cx": 200,
                  "cy": 200
                },
                {
                  "type": "draw_line",
                  "x1": 200,
                  "y1": 28,
                  "x2": 200,
                  "y2": 52,
                  "paint": {
                    "color": "#FFFFFFFF",
                    "style": "stroke",
                    "stroke_width": 2.5
                  }
                },
                {
                  "type": "restore"
                }
              ],
              "_comment": "Major ticks every 1000 RPM"
            },
            {
              "type": "loop",
              "from": 0,
              "step": 1,
              "until": 16,
              "label": "half",
              "children": [
                {
                  "type": "float_expression",
                  "label": "halfAngle",
                  "expr": "($half * 0.5 + 0.5) / 8 * 270 + 135"
                },
                {
                  "type": "save"
                },
                {
                  "type": "rotate",
                  "angle": "$halfAngle",
                  "cx": 200,
                  "cy": 200
                },
                {
                  "type": "draw_line",
                  "x1": 200,
                  "y1": 34,
                  "x2": 200,
                  "y2": 48,
