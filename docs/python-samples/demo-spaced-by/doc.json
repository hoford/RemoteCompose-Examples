            { "type": "box", "modifier": { "size": 60, "background": "#FFFF0000" } },
            { "type": "box", "modifier": { "size": 60, "background": "#FF00FF00" } },
            { "type": "box", "modifier": { "size": 60, "background": "#FF0000FF" } }
          ]
        }
      ]
    }
  ]
}
