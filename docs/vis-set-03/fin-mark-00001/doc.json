    {
     "variable": {
      "name": "sa",
      "value": "sin(@rot)",
      "commit": true
     }
    },
    {
     "variable": {
      "name": "cp",
      "value": "@ca + @sa",
      "commit": true
     }
    },
    {
     "variable": {
      "name": "cm",
      "value": "@sa - @ca",
      "commit": true
     }
    },
    {
     "variable": {
      "name": "dp",
      "value": "@ca - @sa",
      "commit": true
     }
    },
    {
     "variable": {
      "name": "dm",
      "value": "@sa + @ca",
      "commit": true
     }
