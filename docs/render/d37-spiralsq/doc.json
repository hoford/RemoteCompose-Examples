{
  "header": {
    "apiLevel": 7,
    "width": 300,
    "height": 300,
    "contentDescription": "spiralsq",
    "profiles": 513
  },
  "root": {
    "canvas": {
      "modifiers": [
        "fillMaxSize"
      ],
      "commands": [
        {
          "paint": {
            "ops": [
              {
                "style": "fill"
              },
              {
                "linearGradient": {
                  "x1": 0.0,
                  "y1": 0.0,
                  "x2": 0.0,
                  "y2": 300.0,
                  "colors": [
                    "#FF1A237E",
                    "#FF00BCD4"
                  ],
                  "tileMode": 0
                }
              }
            ]
          }
        },
        {
          "drawRect": {
            "left": 0,
            "top": 0,
            "right": 300,
            "bottom": 300
          }
        },
        {
          "paint": {
            "color": "#FFFFFFFF",
            "style": "stroke",
            "width": 1.5
          }
        },
        {
          "loop": {
            "from": 0.0,
            "until": 40.0,
            "index": "i",
            "commands": [
              {
                "save": [
                  {
                    "rotate": {
                      "angle": "i * 12",
                      "pivotX": 150.0,
                      "pivotY": 150.0
                    }
                  },
                  {
                    "drawRoundRect": {
                      "left": "150 - (i * 3.4)",
                      "top": "150 - (i * 3.4)",
                      "right": "150 + (i * 3.4)",
                      "bottom": "150 + (i * 3.4)",
                      "rx": 2.0,
                      "ry": 2.0
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
