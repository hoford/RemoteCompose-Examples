{
  "name": "sparkline",
  "description": "Sparkline: a tiny, axis-free line of a value series, with the last point marked. Use as an inline trend indicator.",
  "tags": [
    "chart",
    "sparkline",
    "mini",
    "trend",
    "data"
  ],
  "data_schema": "value: number[]  — y values in pixels (~0..90)",
  "json": {
    "header": {
      "apiLevel": 7,
      "width": 300,
      "height": 120,
      "contentDescription": "sparkline",
      "profiles": 513,
      "orderedResources": true
    },
    "root": [
      {
        "global": [
          {
            "resources": {
              "floatArrays": [
                {
                  "value": [
                    30,
                    50,
                    40,
                    70,
                    55,
                    85,
                    60,
                    95,
                    80
                  ]
                }
              ]
            }
          },
          {
            "canvas": {
              "modifiers": [
                "fillMaxSize"
              ],
              "commands": [
                {
                  "paint": {
                    "color": "#FF0E1116",
                    "style": "fill"
                  }
                },
                {
                  "drawRect": {
                    "left": 0,
                    "top": 0,
                    "right": 300,
                    "bottom": 120
                  }
                },
                {
                  "variable": {
                    "name": "n",
                    "value": "arrayLength(@value)",
                    "commit": true
                  }
                },
                {
                  "paint": {
                    "color": "#FF18FFB2",
                    "style": "stroke",
                    "width": 3.0,
                    "strokeCap": "round"
                  }
                },
                {
                  "loop": {
                    "from": 0.0,
                    "until": "@n - 1",
                    "index": "i",
                    "commands": [
                      {
                        "drawLine": {
                          "x1": "20 + i * (260 / (@n - 1))",
                          "y1": "100 - arrayGet(@value, i)",
                          "x2": "20 + (i + 1) * (260 / (@n - 1))",
                          "y2": "100 - arrayGet(@value, i + 1)"
                        }
                      }
                    ]
                  }
                },
                {
                  "paint": {
                    "color": "#FF18FFB2",
                    "style": "fill"
                  }
                },
                {
                  "drawCircle": {
                    "cx": 280.0,
                    "cy": "100 - arrayGet(@value, @n - 1)",
                    "radius": 5.0
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
