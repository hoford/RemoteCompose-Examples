{
  "header": {
    "apiLevel": 7,
    "width": 300,
    "height": 300,
    "contentDescription": "ringdots",
    "profiles": 513
  },
  "root": {
    "canvas": {
      "modifiers": [
        "fillMaxSize"
      ],
      "commands": [
        {
          "paint": {
            "color": "#FF0E1116",
            "style": "fill"
          }
        },
        {
          "drawRect": {
            "left": 0,
            "top": 0,
            "right": 300,
            "bottom": 300
          }
        },
        {
          "paint": {
            "color": "#FFFF7043",
            "style": "fill"
          }
        },
        {
          "loop": {
            "from": 0.0,
            "until": 24.0,
            "index": "i",
            "commands": [
              {
                "drawCircle": {
                  "cx": "150 + cos(i * 0.2618) * 110",
                  "cy": "150 + sin(i * 0.2618) * 110",
                  "radius": 10.0
                }
              }
            ]
          }
        }
      ]
    }
  }
}
