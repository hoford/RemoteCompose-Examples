       {
        "variable": {
         "name": "shd",
         "value": "sin(continuousSec()*0.4)"
        }
       },
       {
        "variable": {
         "name": "chd",
         "value": "cos(continuousSec()*0.4)"
        }
       },
       {
        "variable": {
         "name": "srk",
         "value": "sin(sin(continuousSec()*0.7)*0.25)"
        }
       },
       {
        "variable": {
         "name": "crk",
         "value": "cos(sin(continuousSec()*0.7)*0.25)"
        }
       },
       {
        "variable": {
         "name": "max",
         "value": "0"
        }
       },
       {
        "variable": {
         "name": "may",
         "value": "0 - 9.81*@srk"
        }
       },
       {
        "variable": {
         "name": "maz",
         "value": "9.81*@crk"
        }
       },
       {
        "variable": {
         "name": "mgx",
         "value": "0"
        }
       },
       {
        "variable": {
         "name": "mgy",
         "value": "0"
        }
       },
       {
        "variable": {
         "name": "mgz",
         "value": "0.4"
        }
       },
       {
        "variable": {
         "name": "mmx",
         "value": "0 - 20*@shd"
        }
       },
       {
        "variable": {
         "name": "mmy",
         "value": "20*@chd*@crk + 40*@srk"
        }
       },
       {
        "variable": {
         "name": "mmz",
         "value": "20*@chd*@srk - 40*@crk"
        }
       },
       {
        "variable": {
         "name": "an",
         "value": "hypot(hypot(@max, @may), @maz)"
        }
       },
       {
        "variable": {
         "name": "ex",
         "value": "@mmy*@maz - @mmz*@may"
        }
       },
       {
        "variable": {
         "name": "ey",
         "value": "@mmz*@max - @mmx*@maz"
        }
       },
       {
        "variable": {
         "name": "ez",
         "value": "@mmx*@may - @mmy*@max"
        }
       },
       {
        "variable": {
         "name": "ny",
         "value": "@maz*@ex - @max*@ez"
        }
       },
       {
        "variable": {
         "name": "sy",
         "value": "@ey * @an"
        }
       },
       {
        "variable": {
         "name": "hh",
         "value": "hypot(@ny, @sy)"
        }
       },
       {
        "variable": {
         "name": "cm",
         "value": "ifElse(1, (@ny)/(@hh), abs(@hh) - 0.0001)"
        }
       },
       {
        "variable": {
         "name": "sm",
         "value": "ifElse(0, (@sy)/(@hh), abs(@hh) - 0.0001)"
        }
       },
       {
        "variable": {
         "name": "gv",
         "value": "ifElse(0, (@max*@mgx + @may*@mgy + @maz*@mgz)/(@an), abs(@an) - 0.0001)"
        }
       },
       {
        "variable": {
         "name": "mn",
         "value": "hypot(hypot(@mmx, @mmy), @mmz)"
        }
       },
       {
        "variable": {
         "name": "ok",
         "value": "ifElse(0, 1, @mn - 15) * ifElse(0, 1, 90 - @mn)"
        }
       },
       {
        "variable": {
         "name": "mw",
         "value": "0.15 * @ok"
        }
       },
       {
        "variable": {
         "name": "dtc",
         "value": "clamp(0.004, 0.25, deltaTime())"
        }
       },
       {
        "variable": {
         "name": "d",
         "value": "0 - @gv * @dtc"
        }
       },
       {
        "variable": {
         "name": "ee",
         "value": "exp(0 - 6.0*@dtc)"
        }
       },
       {
        "variable": {
         "name": "dte",
         "value": "@dtc * @ee"
        }
       },
       {
        "variable": {
         "name": "k1",
         "value": "1 - @ee - 6.0*@dte"
        }
       },
       {
        "variable": {
         "name": "k2",
         "value": "@ee - 6.0*@dte"
        }
       },
       {
        "variable": {
         "name": "k3",
         "value": "36.0*@dte"
        }
       },
       {
        "variable": {
         "name": "tilt",
