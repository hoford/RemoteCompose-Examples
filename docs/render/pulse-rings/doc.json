{
  "name": "pulse_rings",
  "description": "Pulsing concentric rings animation: rings whose radii breathe over time. A looping ambient/loading animation.",
  "tags": [
    "animation",
    "pulse",
    "rings",
    "loading"
  ],
  "data_schema": null,
  "json": {
    "header": {
      "apiLevel": 7,
      "width": 300,
      "height": 300,
      "contentDescription": "pulse",
      "profiles": 513
    },
    "root": {
      "canvas": {
        "modifiers": [
          "fillMaxSize"
        ],
        "commands": [
          {
            "paint": {
              "color": "#FF0E1116",
              "style": "fill"
            }
          },
          {
            "drawRect": {
              "left": 0,
              "top": 0,
              "right": 300,
              "bottom": 300
            }
          },
          {
            "paint": {
              "color": "#FF18FFB2",
              "style": "stroke",
              "width": 4.0
            }
          },
          {
            "loop": {
              "from": 0.0,
              "until": 6.0,
              "index": "i",
              "commands": [
                {
                  "drawCircle": {
                    "cx": 150.0,
                    "cy": 150.0,
                    "radius": "((sin(time * 2 - i * 0.6) + 1) * 0.5) * 40 + i * 22"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
