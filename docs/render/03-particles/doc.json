{
 "header": {
  "apiLevel": 7,
  "width": 400,
  "height": 400,
  "profiles": 513,
  "orderedResources": true,
  "contentDescription": "120 snowflakes falling and swaying, each one a particle with its own speed, size and opacity"
 },
 "root": [
  {
   "type": "canvas",
   "modifiers": ["fillMaxSize"],
   "commands": [

   {"paint": {"ops": [{"color": "#FF0B1220"}, {"style": "fill"}]}},
   {"drawRect": {"left": 0, "top": 0,
                 "right": "componentWidth()", "bottom": "componentHeight()"}},

   {"createParticles": {
     "id": "snow",
     "variables": ["px", "py", "fall", "size", "fade"],
     "initialValues": [
       "rand() * 400",
       "rand() * 400",
       "0.5 + rand() * 1.6",
       "1.2 + rand() * 2.6",
       "0.25 + rand() * 0.75"
     ],
     "count": 120
   }},

   {"particlesLoop": {
     "system": "@snow",
     "equations": [
       "(px + sin(py * 0.03) * 0.7 + 400) % 400",
       "(py + fall) % 400",
       "fall",
       "size",
       "fade"
     ],
     "commands": [
       {"paint": {"ops": [{"color": "#FFDCE8FF"}, {"style": "fill"}, {"alpha": "fade"}]}},
       {"drawCircle": {"cx": "px", "cy": "py", "radius": "size"}}
     ]
   }}

   ]
  }
 ]
}
