{
  "header": {
    "apiLevel": 7,
    "width": 300,
    "height": 300,
    "contentDescription": "monthly budget donut chart",
    "profiles": 513,
    "orderedResources": true
  },
  "root": [
    {
      "global": [
        {
          "resources": {
            "floatArrays": [
              {
                "part": [
                  35,
                  25,
                  15,
                  25
                ]
              }
            ]
          }
        },
        {
          "canvas": {
            "modifiers": [
              "fillMaxSize"
            ],
            "commands": [
              {
                "paint": {
                  "color": "#FF0E1116",
                  "style": "fill"
                }
              },
              {
                "drawRect": {
                  "left": 0,
                  "top": 0,
                  "right": 300,
                  "bottom": 300
                }
              },
              {
                "variable": {
                  "name": "n",
                  "value": "arrayLength(@part)",
                  "commit": true
                }
              },
              {
                "save": [
                  {
                    "rotate": {
                      "angle": -90.0,
                      "pivotX": 150.0,
                      "pivotY": 150.0
                    }
                  },
                  {
                    "loop": {
                      "from": 0.0,
                      "until": "@n",
                      "index": "i",
                      "commands": [
                        {
                          "conditionalOperations": {
                            "condition": "eq",
                            "v1": "i % 8",
                            "v2": 0.0,
                            "commands": [
                              {
                                "paint": {
                                  "color": "#FF2196F3",
                                  "style": "stroke",
                                  "width": 38.0
                                }
                              }
                            ]
                          }
                        },
                        {
                          "conditionalOperations": {
                            "condition": "eq",
                            "v1": "i % 8",
                            "v2": 1.0,
                            "commands": [
                              {
                                "paint": {
                                  "color": "#FF4CAF50",
                                  "style": "stroke",
                                  "width": 38.0
                                }
                              }
                            ]
                          }
                        },
                        {
                          "conditionalOperations": {
                            "condition": "eq",
                            "v1": "i % 8",
                            "v2": 2.0,
                            "commands": [
                              {
                                "paint": {
                                  "color": "#FFFFC107",
                                  "style": "stroke",
                                  "width": 38.0
                                }
                              }
                            ]
                          }
                        },
                        {
                          "conditionalOperations": {
                            "condition": "eq",
                            "v1": "i % 8",
                            "v2": 3.0,
                            "commands": [
                              {
                                "paint": {
                                  "color": "#FFE91E63",
                                  "style": "stroke",
                                  "width": 38.0
                                }
                              }
                            ]
                          }
                        },
                        {
                          "drawArc": {
                            "left": 80,
                            "top": 80,
                            "right": 220,
                            "bottom": 220,
                            "startAngle": 0.0,
                            "sweepAngle": "arrayGet(@part, i) * 3.6 - 2"
                          }
                        },
                        {
                          "rotate": {
                            "angle": "arrayGet(@part, i) * 3.6",
                            "pivotX": 150.0,
                            "pivotY": 150.0
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "paint": {
                  "color": "#FFFFFFFF",
                  "style": "fill",
                  "textSize": 44.0
                }
              },
              {
                "drawTextAnchored": {
                  "text": "100",
                  "x": 150.0,
                  "y": 150.0,
                  "panX": 0.0,
                  "panY": 0.0,
                  "flags": 0
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
