{
  "name": "bar_vertical",
  "description": "Vertical bar chart: one colored bar per value in an array, bar height proportional to the value. Use for comparing quantities across categories.",
  "tags": [
    "chart",
    "bar",
    "column",
    "compare",
    "data"
  ],
  "data_schema": "value: number[]  — bar heights in pixels (~0..180)",
  "json": {
    "header": {
      "apiLevel": 7,
      "width": 320,
      "height": 240,
      "contentDescription": "bar chart",
      "profiles": 513,
      "orderedResources": true
    },
    "root": [
      {
        "global": [
          {
            "resources": {
              "floatArrays": [
                {
                  "value": [
                    40,
                    90,
                    60,
                    140,
                    110,
                    170,
                    130
                  ]
                }
              ]
            }
          },
          {
            "canvas": {
              "modifiers": [
                "fillMaxSize"
              ],
              "commands": [
                {
                  "paint": {
                    "color": "#FF0E1116",
                    "style": "fill"
                  }
                },
                {
                  "drawRect": {
                    "left": 0,
                    "top": 0,
                    "right": 320,
                    "bottom": 240
                  }
                },
                {
                  "variable": {
                    "name": "n",
                    "value": "arrayLength(@value)",
                    "commit": true
                  }
                },
                {
                  "loop": {
                    "from": 0.0,
                    "until": "@n",
                    "index": "i",
                    "commands": [
                      {
                        "conditionalOperations": {
                          "condition": "eq",
                          "v1": "i % 6",
                          "v2": 0.0,
                          "commands": [
                            {
                              "paint": {
                                "color": "#FF2196F3",
                                "style": "fill"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "conditionalOperations": {
                          "condition": "eq",
                          "v1": "i % 6",
                          "v2": 1.0,
                          "commands": [
                            {
                              "paint": {
                                "color": "#FF4CAF50",
                                "style": "fill"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "conditionalOperations": {
                          "condition": "eq",
                          "v1": "i % 6",
                          "v2": 2.0,
                          "commands": [
                            {
                              "paint": {
                                "color": "#FFFFC107",
                                "style": "fill"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "conditionalOperations": {
                          "condition": "eq",
                          "v1": "i % 6",
                          "v2": 3.0,
                          "commands": [
                            {
                              "paint": {
                                "color": "#FFE91E63",
                                "style": "fill"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "conditionalOperations": {
                          "condition": "eq",
                          "v1": "i % 6",
                          "v2": 4.0,
                          "commands": [
                            {
                              "paint": {
                                "color": "#FF9C27B0",
                                "style": "fill"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "conditionalOperations": {
                          "condition": "eq",
                          "v1": "i % 6",
                          "v2": 5.0,
                          "commands": [
                            {
                              "paint": {
                                "color": "#FF00BCD4",
                                "style": "fill"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "drawRoundRect": {
                          "left": "20 + i * 42",
                          "top": "210 - arrayGet(@value, i)",
                          "right": "20 + i * 42 + 32",
                          "bottom": 210.0,
                          "rx": 5,
                          "ry": 5
                        }
                      }
                    ]
                  }
                },
                {
                  "paint": {
                    "color": "#FF455A64",
                    "style": "stroke",
                    "width": 2.0
                  }
                },
                {
                  "drawLine": {
                    "x1": 14,
                    "y1": 212,
                    "x2": 306,
                    "y2": 212
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
