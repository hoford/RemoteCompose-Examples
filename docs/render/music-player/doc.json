    "contentDescription": "Synthwave Music Player with AGSL Waveform Shader"
  },
  "root": {
    "box": {
      "modifiers": [
        {
          "fillMaxSize": 1.0
        },
        {
          "background": "#0B0416"
        },
        {
          "padding": 16
        },
        {
          "clipRect": 20
        }
      ],
      "children": [
        {
          "canvas": {
            "modifiers": [
              {
                "fillMaxSize": 1.0
              }
            ],
            "commands": [
              {
                "paint": {
                  "style": "fill",
                  "shader": {
                    "agsl": "uniform float2 iResolution;\nuniform float iTime;\nhalf4 main(float2 fragCoord) {\n    float2 uv = (fragCoord - 0.5 * iResolution) / min(iResolution.x, iResolution.y);\n    float t = iTime * 2.5;\n    float wave1 = sin(uv.x * 12.0 + t) * 0.15;\n    float wave2 = cos(uv.x * 18.0 - t * 1.4) * 0.10;\n    float wave3 = sin(uv.x * 24.0 + t * 0.9) * 0.06;\n    float lineDist = abs(uv.y - (wave1 + wave2 + wave3));\n    float glow = 0.015 / (lineDist + 0.006);\n    float3 col = float3(0.7 + 0.3 * sin(t), 0.2 + 0.8 * cos(uv.x * 4.0), 0.95);\n    return half4(col * glow, clamp(glow * 0.7, 0.0, 0.9));\n}",
                    "uniforms": {
                      "iResolution": [
                        "componentWidth()",
                        "componentHeight()"
                      ],
                      "iTime": "continuousSec()"
                    }
                  }
                }
              },
              {
                "drawRect": {
                  "left": 0,
                  "top": 0,
                  "right": "componentWidth()",
                  "bottom": "componentHeight()"
                }
              }
            ]
          }
        },
