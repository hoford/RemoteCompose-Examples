{
  "header": {
    "apiLevel": 7,
    "width": 320,
    "height": 240,
    "contentDescription": "sine",
    "profiles": 513
  },
  "root": {
    "canvas": {
      "modifiers": [
        "fillMaxSize"
      ],
      "commands": [
        {
          "paint": {
            "color": "#FF0E1116",
            "style": "fill"
          }
        },
        {
          "drawRect": {
            "left": 0,
            "top": 0,
            "right": 320,
            "bottom": 240
          }
        },
        {
          "pathCreate": {
            "id": "w",
            "x": 0.0,
            "y": 120.0
          }
        },
        {
          "loop": {
            "from": 1.0,
            "until": 64.0,
            "index": "i",
            "commands": [
              {
                "pathAppendLineTo": {
                  "path": "w",
                  "x": "i * 5",
                  "y": "120 + sin(i * 0.28) * 70"
                }
              }
            ]
          }
        },
        {
          "paint": {
            "color": "#FF18FFB2",
            "style": "stroke",
            "width": 3.0,
            "strokeCap": "round"
          }
        },
        {
          "drawPath": {
            "path": "w"
          }
        }
      ]
    }
  }
}
