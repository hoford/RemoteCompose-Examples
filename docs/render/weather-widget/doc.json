                              0,
                              16
                            ]
                          }
                        ],
                        "children": [
                          {
                            "text": {
                              "value": "H: 76° L: 58°",
                              "fontSize": 12,
                              "color": "#E0F2FE"
                            }
                          },
                          {
                            "text": {
                              "value": "Humidity 45%",
