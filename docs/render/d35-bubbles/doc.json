{
  "header": {
    "apiLevel": 7,
    "width": 300,
    "height": 300,
    "contentDescription": "bubbles",
    "profiles": 513
  },
  "root": {
    "canvas": {
      "modifiers": [
        "fillMaxSize"
      ],
      "commands": [
        {
          "paint": {
            "color": "#FF0E1116",
            "style": "fill"
          }
        },
        {
          "drawRect": {
            "left": 0,
            "top": 0,
            "right": 300,
            "bottom": 300
          }
        },
        {
          "paint": {
            "color": "#FFB388FF",
            "style": "stroke",
            "width": 2.0
          }
        },
        {
          "loop": {
            "from": 0.0,
            "until": 70.0,
            "index": "i",
            "commands": [
              {
                "drawCircle": {
                  "cx": "150 + cos(i * 0.5) * (i * 1.8)",
                  "cy": "150 + sin(i * 0.5) * (i * 1.8)",
                  "radius": "3 + (sin(i * 0.3) + 1) * 7"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
