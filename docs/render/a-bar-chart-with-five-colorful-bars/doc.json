{
  "header": {
    "apiLevel": 7,
    "width": 320,
    "height": 240,
    "contentDescription": "bar chart",
    "profiles": 513,
    "orderedResources": true
  },
  "root": [
    {
      "global": [
        {
          "resources": {
            "floatArrays": [
              {
                "value": [
                  80,
                  160,
                  40,
                  120,
                  90
                ]
              }
            ]
          }
        },
        {
          "canvas": {
            "modifiers": [
              "fillMaxSize"
            ],
            "commands": [
              {
                "paint": {
                  "color": "#FF0E1116",
                  "style": "fill"
                }
              },
              {
                "drawRect": {
                  "left": 0,
                  "top": 0,
                  "right": 320,
                  "bottom": 240
                }
              },
              {
                "variable": {
                  "name": "n",
                  "value": "arrayLength(@value)",
                  "commit": true
                }
              },
              {
                "loop": {
                  "from": 0.0,
                  "until": "@n",
                  "index": "i",
                  "commands": [
                    {
                      "conditionalOperations": {
                        "condition": "eq",
                        "v1": "i % 6",
                        "v2": 0.0,
                        "commands": [
                          {
                            "paint": {
                              "color": "#FF2196F3",
                              "style": "fill"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "conditionalOperations": {
                        "condition": "eq",
                        "v1": "i % 6",
                        "v2": 1.0,
                        "commands": [
                          {
                            "paint": {
                              "color": "#FF4CAF50",
                              "style": "fill"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "conditionalOperations": {
                        "condition": "eq",
                        "v1": "i % 6",
                        "v2": 2.0,
                        "commands": [
                          {
                            "paint": {
                              "color": "#FFFFC107",
                              "style": "fill"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "conditionalOperations": {
                        "condition": "eq",
                        "v1": "i % 6",
                        "v2": 3.0,
                        "commands": [
                          {
                            "paint": {
                              "color": "#FFE91E63",
                              "style": "fill"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "conditionalOperations": {
                        "condition": "eq",
                        "v1": "i % 6",
                        "v2": 4.0,
                        "commands": [
                          {
                            "paint": {
                              "color": "#FF9C27B0",
                              "style": "fill"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "drawRoundRect": {
                        "left": "20 + i * 70",
                        "top": "210 - arrayGet(@value, i)",
                        "right": "20 + i * 70 + 35",
                        "bottom": 210.0,
                        "rx": 5,
                        "ry": 5
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
