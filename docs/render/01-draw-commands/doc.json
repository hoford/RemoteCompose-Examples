{
 "header": {
  "apiLevel": 7,
  "width": 400,
  "height": 400,
  "profiles": 513,
  "orderedResources": true,
  "contentDescription": "A ring, a sweeping arc and an orbiting dot, all driven by the clock"
 },
 "root": [
  {
   "type": "canvas",
   "modifiers": ["fillMaxSize"],
   "commands": [

   {"paint": {"ops": [{"color": "#FF0B1220"}, {"style": "fill"}]}},
   {"drawRect": {"left": 0, "top": 0,
                 "right": "componentWidth()", "bottom": "componentHeight()"}},

   {"paint": {"ops": [{"color": "#FF1B2740"}, {"style": "stroke"}, {"width": 10}]}},
   {"drawCircle": {"cx": 200, "cy": 200, "radius": 120}},

   {"paint": {"ops": [{"color": "#FF7BD88F"}, {"style": "stroke"}, {"width": 10},
                      {"strokeCap": "round"}]}},
   {"drawArc": {"left": 80, "top": 80, "right": 320, "bottom": 320,
                "startAngle": "continuousSec() * 45", "sweepAngle": 70}},

   {"save": {}},
   {"rotate": {"angle": "continuousSec() * 45 + 70", "pivotX": 200, "pivotY": 200}},
   {"paint": {"ops": [{"color": "#FFFFC46B"}, {"style": "fill"}]}},
   {"drawCircle": {"cx": 320, "cy": 200, "radius": 12}},
   {"restore": {}},

   {"paint": {"ops": [{"color": "#FF6AA9FF"}, {"style": "fill"}]}},
   {"drawCircle": {"cx": 200, "cy": 200,
                   "radius": "22 + 4 * sin(continuousSec() * 3.1415927)"}}

   ]
  }
 ]
}
